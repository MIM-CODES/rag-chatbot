# --- LLM Provider (سازگار با OpenAI؛ پیش‌فرض Ollama) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# نام مدل چت در Ollama؛ مثال: qwen2.5:7b-instruct یا llama3.1:8b
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=180

# --- Embedding (همان سرویس Ollama) ---
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
# نام مدل embedding در Ollama؛ مثال: bge-m3 یا nomic-embed-text یا embeddinggemma
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=180

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=company_knowledge_base

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
RETRIEVAL_TOP_K=5
# شباهت کسینوسی؛ ۰.۲۵ تا ۰.۳۵ برای مدل‌های embedding چندزبانه معمول است
SIMILARITY_THRESHOLD=0.25
CONTEXT_MAX_CHARS=6000

# --- اپلیکیشن ---
HISTORY_MAX_TURNS=6
MAX_UPLOAD_MB=25
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- مسیرها (نسبت به پوشه backend) ---
RAW_DOCUMENTS_DIR=./data/raw_documents
